// A heading indicator: a compass card that turns under a fixed heading mark

import { Theme } from "theme.slint";

export component Heading inherits Rectangle {
    // magnetic heading, 0deg is north, positive clockwise
    in property <angle> heading: 0deg;

    private property <length> size: min(self.width, self.height);
    private property <float> size_float: size / 1px;
    // widths and font sizes are those of Theme at Theme.reference_size, scaled with the size of
    // the instrument, so it keeps its proportions on the desktop; exactly 1 on the device
    private property <float> scale: size / Theme.reference_size;
    // font size on whole pixels: the device has glyphs of the sizes in Theme only, and a
    // fraction below them would fall back to the next smaller size
    private property <length> large_font_size: round(Theme.large_font_size * scale / 1px) * 1px;

    // all values in viewbox units, which are pixels of the instrument
    private property <float> center: size_float / 2;
    // No bezel ring: the card reaches almost to the edge of the instrument, its inner radius is
    // 0.49 of the size (0.5 - RING_RATIO of the heading dial in tools/dial-paths.py).
    // large enough for two digits in Theme.large_font_size, the device clips text to its box
    private property <float> label_half_width: size_float * 0.06;
    private property <float> label_half_height: size_float * 0.045;

    // The whole card turns, so the card is redrawn every frame, like the inner disc of the
    // attitude indicator. The software renderer can't rotate, so every point of the card is
    // turned with the sine and cosine of the heading. The labels stay upright, text can't be
    // rotated either.
    // The functions keep the compiler from inlining sin/cos into every place that uses these
    // properties: inlined, they are evaluated again for each coordinate, in f64, which is very
    // slow on the RP2040. As properties they are calculated once per change of the heading.
    private property <float> sin_heading: sin_of(root.heading);
    private property <float> cos_heading: cos_of(root.heading);
    pure function sin_of(a: angle) -> float {
        return sin(a);
    }
    pure function cos_of(a: angle) -> float {
        return cos(a);
    }

    // A point of the card at offset (px, py) from the center with north up is turned by the
    // heading against the clock, so the current heading is at the top:
    //   x = center + px * cos_heading + py * sin_heading
    //   y = center - px * sin_heading + py * cos_heading
    // This is written out in every coordinate instead of calling a function: the compiler then
    // reads each property once per path; in a function it reads them again for every call,
    // inlines the sine and cosine into it, and each read costs a dependency node of heap.

    background: transparent;    // show background of parent

    // all parts in a square of `size`, centered in the area the instrument is given
    Rectangle {
        x: (root.width - root.size) / 2;
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;

        // Card: ticks every 10 degree, long and wide ones every 30 degree, almost to the edge, and
        // labels every 30 degree. The ticks are thin filled quadrilaterals in three paths, whose box
        // is the whole card: the ticks move around all of it. Each path rebuilds its elements every
        // frame, three small paths keep these blocks small (about 1.6 KB, a single path would need
        // 5 KB), so they are still found when the heap is fragmented, and a band of a path stays
        // within the rasterizer cells the renderer reserves. A path has a single fill, so the
        // orange ticks of N, E, S and W are a fourth path. The coordinates on the card are
        // precomputed, per frame each corner only needs the sine and cosine of the heading.
        // Fixed parts: the red marks at 12 (the heading mark), 3, 6 and 9 o'clock lie over the outer
        // ends of the card ticks, opposite ones in one path, the outline of a jet in the middle.
        // They are small and redrawn with the turning card, drawn after it so they stay on top. The
        // jet is stroked in four open lines: in fewer paths, a band needs more rasterizer cells,
        // and the cells of zeno grow to a larger block (as one outline to 16 KB).
        // Generated by tools/dial-paths.py. Run it again after changing the card, the size of the
        // dial or Theme.marking_width.

        // BEGIN generated by tools/dial-paths.py, do not edit
        // card ticks 10deg to 120deg, they turn with the card
        Path {
            viewbox-x: size_float * 0.010000 - 2.5000;
            viewbox-y: size_float * 0.010000 - 2.5000;
            viewbox-width: size_float * 0.980000 + 5.0000;
            viewbox-height: size_float * 0.980000 + 5.0000;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.marking;

            MoveTo {
                x: center + (size_float * 0.081358) * cos_heading + (size_float * -0.443409) * sin_heading;
                y: center - (size_float * 0.081358) * sin_heading + (size_float * -0.443409) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.088165) * cos_heading + (size_float * -0.482013) * sin_heading;
                y: center - (size_float * 0.088165) * sin_heading + (size_float * -0.482013) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.082010) * cos_heading + (size_float * -0.483098) * sin_heading;
                y: center - (size_float * 0.082010) * sin_heading + (size_float * -0.483098) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.075203) * cos_heading + (size_float * -0.444494) * sin_heading;
                y: center - (size_float * 0.075203) * sin_heading + (size_float * -0.444494) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.081358) * cos_heading + (size_float * -0.443409) * sin_heading;
                y: center - (size_float * 0.081358) * sin_heading + (size_float * -0.443409) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.157119) * cos_heading + (size_float * -0.422545) * sin_heading;
                y: center - (size_float * 0.157119) * sin_heading + (size_float * -0.422545) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.170526) * cos_heading + (size_float * -0.459381) * sin_heading;
                y: center - (size_float * 0.170526) * sin_heading + (size_float * -0.459381) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.164653) * cos_heading + (size_float * -0.461518) * sin_heading;
                y: center - (size_float * 0.164653) * sin_heading + (size_float * -0.461518) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.151246) * cos_heading + (size_float * -0.424682) * sin_heading;
                y: center - (size_float * 0.151246) * sin_heading + (size_float * -0.424682) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.157119) * cos_heading + (size_float * -0.422545) * sin_heading;
                y: center - (size_float * 0.157119) * sin_heading + (size_float * -0.422545) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.213663) * cos_heading + (size_float * -0.357575) * sin_heading;
                y: center - (size_float * 0.213663) * sin_heading + (size_float * -0.357575) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.250413) * cos_heading + (size_float * -0.421227) * sin_heading;
                y: center - (size_float * 0.250413) * sin_heading + (size_float * -0.421227) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.239587) * cos_heading + (size_float * -0.427477) * sin_heading;
                y: center - (size_float * 0.239587) * sin_heading + (size_float * -0.427477) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.202837) * cos_heading + (size_float * -0.363825) * sin_heading;
                y: center - (size_float * 0.202837) * sin_heading + (size_float * -0.363825) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.213663) * cos_heading + (size_float * -0.357575) * sin_heading;
                y: center - (size_float * 0.213663) * sin_heading + (size_float * -0.357575) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.292163) * cos_heading + (size_float * -0.343324) * sin_heading;
                y: center - (size_float * 0.292163) * sin_heading + (size_float * -0.343324) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.317360) * cos_heading + (size_float * -0.373353) * sin_heading;
                y: center - (size_float * 0.317360) * sin_heading + (size_float * -0.373353) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.312572) * cos_heading + (size_float * -0.377370) * sin_heading;
                y: center - (size_float * 0.312572) * sin_heading + (size_float * -0.377370) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.287375) * cos_heading + (size_float * -0.347342) * sin_heading;
                y: center - (size_float * 0.287375) * sin_heading + (size_float * -0.347342) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.292163) * cos_heading + (size_float * -0.343324) * sin_heading;
                y: center - (size_float * 0.292163) * sin_heading + (size_float * -0.343324) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.347342) * cos_heading + (size_float * -0.287375) * sin_heading;
                y: center - (size_float * 0.347342) * sin_heading + (size_float * -0.287375) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.377370) * cos_heading + (size_float * -0.312572) * sin_heading;
                y: center - (size_float * 0.377370) * sin_heading + (size_float * -0.312572) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.373353) * cos_heading + (size_float * -0.317360) * sin_heading;
                y: center - (size_float * 0.373353) * sin_heading + (size_float * -0.317360) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.343324) * cos_heading + (size_float * -0.292163) * sin_heading;
                y: center - (size_float * 0.343324) * sin_heading + (size_float * -0.292163) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.347342) * cos_heading + (size_float * -0.287375) * sin_heading;
                y: center - (size_float * 0.347342) * sin_heading + (size_float * -0.287375) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.363825) * cos_heading + (size_float * -0.202837) * sin_heading;
                y: center - (size_float * 0.363825) * sin_heading + (size_float * -0.202837) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.427477) * cos_heading + (size_float * -0.239587) * sin_heading;
                y: center - (size_float * 0.427477) * sin_heading + (size_float * -0.239587) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.421227) * cos_heading + (size_float * -0.250413) * sin_heading;
                y: center - (size_float * 0.421227) * sin_heading + (size_float * -0.250413) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.357575) * cos_heading + (size_float * -0.213663) * sin_heading;
                y: center - (size_float * 0.357575) * sin_heading + (size_float * -0.213663) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.363825) * cos_heading + (size_float * -0.202837) * sin_heading;
                y: center - (size_float * 0.363825) * sin_heading + (size_float * -0.202837) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.424682) * cos_heading + (size_float * -0.151246) * sin_heading;
                y: center - (size_float * 0.424682) * sin_heading + (size_float * -0.151246) * cos_heading;
