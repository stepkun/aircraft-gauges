            LineTo {
                x: center + (size_float * 0.461518) * cos_heading + (size_float * -0.164653) * sin_heading;
                y: center - (size_float * 0.461518) * sin_heading + (size_float * -0.164653) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.459381) * cos_heading + (size_float * -0.170526) * sin_heading;
                y: center - (size_float * 0.459381) * sin_heading + (size_float * -0.170526) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.422545) * cos_heading + (size_float * -0.157119) * sin_heading;
                y: center - (size_float * 0.422545) * sin_heading + (size_float * -0.157119) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.424682) * cos_heading + (size_float * -0.151246) * sin_heading;
                y: center - (size_float * 0.424682) * sin_heading + (size_float * -0.151246) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.444494) * cos_heading + (size_float * -0.075203) * sin_heading;
                y: center - (size_float * 0.444494) * sin_heading + (size_float * -0.075203) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.483098) * cos_heading + (size_float * -0.082010) * sin_heading;
                y: center - (size_float * 0.483098) * sin_heading + (size_float * -0.082010) * cos_heading;
            }

            LineTo {
