                y: center - (size_float * 0.443409) * sin_heading + (size_float * -0.081358) * cos_heading;
            }

            LineTo {
                x: center + (size_float * 0.444494) * cos_heading + (size_float * -0.075203) * sin_heading;
                y: center - (size_float * 0.444494) * sin_heading + (size_float * -0.075203) * cos_heading;
            }

            Close { }

            MoveTo {
                x: center + (size_float * 0.443409) * cos_heading + (size_float * 0.081358) * sin_heading;
                y: center - (size_float * 0.443409) * sin_heading + (size_float * 0.081358) * cos_heading;
