                color: Theme.marking;
                font-size: small_font_size;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: 12 * u;
                y: (106 * scale + alt_offset500 - 150 * scale - 8 * scale) * 1px;
                width: 40 * u;
                height: 16 * u;
                text: "\{alt_base500 + 1500}";
                color: Theme.marking;
                font-size: small_font_size;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }

        // ---- heading tape, ticks at its lower edge

        Rectangle {
            x: 0;
            y: 0;
            width: 320 * u;
            height: 28 * u;
            background: Theme.bezel;
            clip: true;

            // ticks every 5 degree
            Path {
                width: parent.width;
                height: parent.height;
                // Slint fits the viewbox of a stroke into the box less the stroke width: the
                // viewbox is that much smaller, so the coordinates are those of the parent
                viewbox-x: 2 * scale / 2;
                viewbox-y: 2 * scale / 2;
                viewbox-width: self.width / 1px - 2 * scale;
                viewbox-height: self.height / 1px - 2 * scale;
                stroke: Theme.marking;
                stroke-width: 2 * scale * 1px;

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 150 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 150 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 135 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 135 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 120 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 120 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 105 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 105 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 90 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 90 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 75 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 75 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 60 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 60 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 45 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 45 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 30 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 30 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 - 15 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 - 15 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 0 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 0 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 15 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 15 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 30 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 30 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 45 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 45 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 60 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 60 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 75 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 75 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 90 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 90 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 105 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 105 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 120 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 120 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 135 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 135 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 150 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 150 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset5 + 165 * scale);
                    y: 24 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset5 + 165 * scale);
                    y: 28 * scale;
                }
            }

            // long ticks every 15 degree, at the names
            Path {
                width: parent.width;
                height: parent.height;
                // Slint fits the viewbox of a stroke into the box less the stroke width: the
                // viewbox is that much smaller, so the coordinates are those of the parent
                viewbox-x: 2 * scale / 2;
                viewbox-y: 2 * scale / 2;
                viewbox-width: self.width / 1px - 2 * scale;
                viewbox-height: self.height / 1px - 2 * scale;
                stroke: Theme.marking;
                stroke-width: 2 * scale * 1px;

                MoveTo {
                    x: round(154 * scale - hdg_offset15 - 135 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 - 135 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset15 - 90 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 - 90 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset15 - 45 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 - 45 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset15 + 0 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 + 0 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset15 + 45 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 + 45 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset15 + 90 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 + 90 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset15 + 135 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 + 135 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset15 + 180 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset15 + 180 * scale);
                    y: 28 * scale;
                }
            }

            // N, E, S and W in orange, like on the heading card
            Path {
                width: parent.width;
                height: parent.height;
                // Slint fits the viewbox of a stroke into the box less the stroke width: the
                // viewbox is that much smaller, so the coordinates are those of the parent
                viewbox-x: 3 * scale / 2;
                viewbox-y: 3 * scale / 2;
                viewbox-width: self.width / 1px - 3 * scale;
                viewbox-height: self.height / 1px - 3 * scale;
                stroke: Theme.cardinal;
                stroke-width: 3 * scale * 1px;

                MoveTo {
                    x: round(154 * scale - hdg_offset90 + 0 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset90 + 0 * scale);
                    y: 28 * scale;
                }

                MoveTo {
                    x: round(154 * scale - hdg_offset90 + 270 * scale);
                    y: 20 * scale;
                }

                LineTo {
                    x: round(154 * scale - hdg_offset90 + 270 * scale);
                    y: 28 * scale;
                }
            }

            // names every 15 degree
            Text {
                x: (154 * scale - hdg_offset15 - 135 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 - 45);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: (154 * scale - hdg_offset15 - 90 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 - 30);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: (154 * scale - hdg_offset15 - 45 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 - 15);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: (154 * scale - hdg_offset15 + 0 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 + 0);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: (154 * scale - hdg_offset15 + 45 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 + 15);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: (154 * scale - hdg_offset15 + 90 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 + 30);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: (154 * scale - hdg_offset15 + 135 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 + 45);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Text {
                x: (154 * scale - hdg_offset15 + 180 * scale - 15 * scale) * 1px;
                y: 2 * u;
                width: 30 * u;
                height: 16 * u;
                text: heading_name(hdg_base15 + 60);
                color: Theme.marking;
                font-size: small_font_size;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }

            // the heading: a triangle at the lower edge, counterclockwise and closed
            Path {
                viewbox-x: 148 * scale;
                viewbox-y: 20 * scale;
                viewbox-width: 12 * scale;
                viewbox-height: 9 * scale;
                x: self.viewbox-x * 1px;
                y: self.viewbox-y * 1px;
                width: self.viewbox-width * 1px;
                height: self.viewbox-height * 1px;
                fill: Theme.marker;

                MoveTo {
                    x: 149 * scale;
                    y: 28 * scale;
                }

                LineTo {
                    x: 159 * scale;
                    y: 28 * scale;
                }

                LineTo {
                    x: 154 * scale;
                    y: 21 * scale;
                }

                LineTo {
                    x: 149 * scale;
                    y: 28 * scale;
                }

                Close { }
            }
        }

        // ---- current vertical speed and altitude, in fields over the middle of the tapes, with a
        // point towards the attitude, inside the tape (the boxes end at the attitude, so it isn't
        // redrawn with them); the numbers reach a little into the base of the point, which is
        // still high enough there. In the small font like the other fields: the 40 units of the
        // tape are too narrow for "-1850" in the larger one. Counterclockwise and static, from
        // the corner after the vertical side of the tape, so the closing edge is vertical and
        // doesn't change the direction Slint calculates (see counterclockwise() in
        // tools/dial-paths.py).
        Path {
            viewbox-x: 0 * scale;
            viewbox-y: 123 * scale;
            viewbox-width: 40 * scale;
            viewbox-height: 22 * scale;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.background;

            MoveTo {
                x: 0 * scale;
                y: 144 * scale;
            }

            LineTo {
                x: 35 * scale;
                y: 144 * scale;
            }

            LineTo {
                x: 40 * scale;
                y: 134 * scale;
            }

            LineTo {
                x: 35 * scale;
                y: 124 * scale;
            }

            LineTo {
                x: 0 * scale;
                y: 124 * scale;
            }

            Close { }
        }

        Text {
            x: 0 * u;
            y: 124 * u;
            width: 37 * u;
            height: 20 * u;
            text: "\{root.vertical_speed > 4 ? "+" : ""}\{round(root.vertical_speed / 10) * 10}";
            color: Theme.marking;
            font-size: small_font_size;
            horizontal-alignment: TextHorizontalAlignment.center;
            vertical-alignment: TextVerticalAlignment.center;
        }

        Path {
            viewbox-x: 268 * scale;
            viewbox-y: 123 * scale;
            viewbox-width: 52 * scale;
            viewbox-height: 22 * scale;
            x: self.viewbox-x * 1px;
            y: self.viewbox-y * 1px;
            width: self.viewbox-width * 1px;
            height: self.viewbox-height * 1px;
            fill: Theme.background;

            MoveTo {
                x: 320 * scale;
                y: 124 * scale;
            }

            LineTo {
                x: 273 * scale;
                y: 124 * scale;
            }

            LineTo {
                x: 268 * scale;
                y: 134 * scale;
            }

            LineTo {
                x: 273 * scale;
                y: 144 * scale;
            }

            LineTo {
                x: 320 * scale;
                y: 144 * scale;
            }

            Close { }
        }

        Text {
            x: 271 * u;
            y: 124 * u;
            width: 49 * u;
            height: 20 * u;
            text: "\{round(root.altitude)}";
            color: Theme.marking;
            font-size: small_font_size;
            horizontal-alignment: TextHorizontalAlignment.center;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
}
